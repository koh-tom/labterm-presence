{
  "name": "labterm-presence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @labterm/daemon start",
    "test": "vitest run",
    "check": "biome check . && pnpm -r typecheck",
    "fake-device": "pnpm --filter @labterm/daemon fake-device"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
